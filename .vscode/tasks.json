{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Agentic AI Hub",
      "dependsOn": ["Start backend", "Start frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Start backend",
      "type": "process",
      "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe",
      "args": ["-m", "uvicorn", "app.main:app", "--reload"],
      "options": {
        "cwd": "${workspaceFolder}\\backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "agentic-ai-hub-backend",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Application startup complete\\."
        }
      }
    },
    {
      "label": "Start frontend",
      "type": "process",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "agentic-ai-hub-frontend",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "http://localhost:5173/"
        }
      }
    }
  ]
}
